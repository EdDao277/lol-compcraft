RIOT_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Riot ladder seed settings. stats:general pulls public ranked ladder entries,
# resolves them to PUUIDs, then crawls Match-V5 from those accounts.
RIOT_PLATFORM_REGION=na1
RIOT_ROUTING_REGION=americas
RIOT_LADDER_QUEUES=RANKED_SOLO_5x5,RANKED_FLEX_SR
RIOT_LADDER_INCLUDE_HIGH_ELO=true
RIOT_LADDER_HIGH_ELO_TIERS=CHALLENGER,GRANDMASTER,MASTER
RIOT_LADDER_HIGH_ELO_PLAYERS_PER_SOURCE=75
RIOT_LADDER_INCLUDE_MIXED_RANKED=true
RIOT_LADDER_MIXED_TIERS=DIAMOND,EMERALD,PLATINUM,GOLD
RIOT_LADDER_MIXED_DIVISIONS=I,II
RIOT_LADDER_RANKED_PAGES=2
RIOT_LADDER_RANKED_PLAYERS_PER_SOURCE=50

# Network stat crawl settings. Queue IDs: 400 Normal Draft, 420 Ranked Solo/Duo, 440 Ranked Flex.
# Defaults are sized for a larger ladder crawl with a personal Riot API key.
RIOT_NETWORK_QUEUE_IDS=400,420,440
RIOT_NETWORK_MATCHES_PER_PLAYER=80
RIOT_NETWORK_MAX_DEPTH=2
RIOT_NETWORK_MAX_PLAYERS=1500
RIOT_NETWORK_MAX_MATCHES=75000
RIOT_NETWORK_CACHE_TTL_DAYS=2

# Upload pruning keeps Supabase focused on useful, higher-confidence aggregates.
# These defaults are sized for the free Supabase 0.5 GB database limit.
# Lower them if you upgrade storage; raise them if Supabase storage gets tight.
RIOT_UPLOAD_MIN_ROLE_GAMES=20
RIOT_UPLOAD_MIN_SYNERGY_GAMES=5
RIOT_UPLOAD_MIN_SAME_ROLE_MATCHUP_GAMES=5
RIOT_UPLOAD_MIN_CROSS_TEAM_MATCHUP_GAMES=10
RIOT_UPLOAD_MIN_TEAM_COMP_GAMES=5
RIOT_UPLOAD_MAX_ROLE_ROWS=50000
RIOT_UPLOAD_MAX_SYNERGY_ROWS=500000
RIOT_UPLOAD_MAX_MATCHUP_ROWS=500000
RIOT_UPLOAD_MAX_TEAM_COMP_ROWS=25000

# LightGBM ranker inputs.
# Put downloaded Oracle Elixir CSV files in data/ml/oracle by default.
ML_ORACLE_CSV_DIR=data/ml/oracle

# ML advisor hosting artifacts. These files are uploaded to Supabase Storage by:
# npm run ml:upload-artifacts
ML_ARTIFACT_BUCKET=compcraft-ml-artifacts
ML_MODEL_PATH=data/ml/models/draft_win_predictor.joblib
ML_COACH_MODEL_PATH=data/ml/models/draft_coach.joblib
ML_NETWORK_STATS_PATH=data/ml/training/supabase_network_stats.json
ML_GZIP_NETWORK_STATS=true
